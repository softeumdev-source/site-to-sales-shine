# Envio de e-mails (formulário de demo e chamados de suporte)
RESEND_API_KEY=

# Projeto Supabase — o MESMO da plataforma de pedidos.
# É o que permite o cliente entrar na aba de suporte com o login da plataforma.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Mesmos valores acima, lidos pelas funções serverless (api/).
# Podem ficar vazios: as funções caem para as VITE_* quando estas faltam.
SUPABASE_URL=
SUPABASE_ANON_KEY=
